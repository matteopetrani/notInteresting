{
  "manifest_version": 3,
  "name": "notInteresting",
  "version": "0.1.0",
  "description": "One-click \"Not interested\" on LinkedIn and X.",
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
